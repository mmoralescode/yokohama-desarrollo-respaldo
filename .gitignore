# Runtime data and credentials never belong in Git.
**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/data/
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite*
**/node_modules/
**/.next/
**/.next-*/
**/out/
**/playwright-report/
**/test-results/
**/*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example
**/*.log
tmp/
.runtime/

# Archivos operativos y credenciales excluidos del respaldo de fuentes.
.env
.env.*
!.env.example
!.env.sample
!.env.template
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
**/.git/
**/node_modules/
**/.vercel/
**/.runtime/
**/.venv/
**/venv/
**/__pycache__/
**/.next*/
**/test-results*/
**/playwright-report/
**/operations/
**/private/
**/*.db
**/*.db-*
**/*.sqlite*
**/*.bak
**/*.dump
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.tsbuildinfo
**/*.log
