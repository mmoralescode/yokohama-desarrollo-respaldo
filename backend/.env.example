# Clave privada compartida únicamente entre los procesos backend y frontend.
# No subir claves, bases SQLite ni fotografías locales en el paquete de código.
# Las fotografías operativas se almacenan como evidencia privada en la base.
YOKOHAMA_API_KEY=
# Mantener vacío en operación. La configuración inicial de la empresa se hace
# con python -m app.provision_owner --database-url URL --password-file RUTA_PRIVADA.
# Solo las pruebas aisladas usan la ruta antigua de setup con un token sintético.
YOKOHAMA_SETUP_TOKEN=
# true cierra el acceso a datos incluso antes de crear la primera cuenta.
# Con cualquier cuenta existente, el inicio de sesión es obligatorio siempre.
YOKOHAMA_REQUIRE_AUTH=true
# La única cuenta administradora permitida es admin.yoko@gmail.com.
# Su contraseña se recibe por archivo privado, variable de entorno o prompt
# oculto del CLI; nunca se incluye aquí ni en una variable NEXT_PUBLIC_.
# Opcional; por defecto backend/data/yokohama.db. No apunta a EXCOBA.
# YOKOHAMA_DATABASE_URL=sqlite:///data/yokohama.db
# YOKOHAMA_POLICY_PATH=../config/policy.json
# cloud requiere PostgreSQL persistente, clave privada de al menos 32 caracteres
# y el administrador activo provisionado por un proceso privado.
YOKOHAMA_DEPLOYMENT_MODE=local
# En Vercel: YOKOHAMA_DEPLOYMENT_MODE=cloud y URL Neon con host -pooler.
# El driver verifica certificado/hostname (verify-full) y channel binding.
