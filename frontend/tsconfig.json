    ".next-administracion-final/dev/types/**/*.ts",
    ".next-administration-proposal-e2e/types/**/*.ts",
    ".next-administration-proposal-e2e/dev/types/**/*.ts",
    ".next-administracion-final-v2/types/**/*.ts",
