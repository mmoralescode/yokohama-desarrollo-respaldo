# Modo local por defecto. Cloud requiere API privada HTTPS y PostgreSQL persistente.
# No copiar credenciales reales, fotos o la base SQLite al frontend/public.
YOKOHAMA_DEPLOYMENT_MODE=local
YOKOHAMA_API_URL=http://127.0.0.1:8000
# Clave privada del servidor; idéntica a la API. Nunca NEXT_PUBLIC_* ni Git.
YOKOHAMA_API_KEY=
# Cloud (configurar en el servidor de Vercel, sin claves en este ejemplo):
# YOKOHAMA_DEPLOYMENT_MODE=cloud
# YOKOHAMA_PUBLIC_ORIGIN=https://yokohama-propuesta.vercel.app
# YOKOHAMA_API_URL=https://api-privada-de-la-empresa.vercel.app
# false para el sistema con cuentas reales; true únicamente para la propuesta.
# Esta variable debe coincidir al compilar y al iniciar el servidor.
NEXT_PUBLIC_YOKOHAMA_PROPOSAL_MODE=false
# El bootstrap del administrador se ejecuta fuera de la web pública.
# VERCEL=1 lo define la plataforma: no habilitarlo manualmente en servidores locales.
